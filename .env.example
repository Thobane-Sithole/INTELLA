# ──────────────────────────────────────────────
# INTELLA — Required Environment Variables
# Copy this file to .env.local for local dev
# Add all keys in your Vercel project settings
# ──────────────────────────────────────────────

# Claude AI (brain) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Groq (voice TTS + STT) — https://console.groq.com
GROQ_API_KEY=gsk_...

# Neo4j Aura (database) — https://aura.neo4j.io
# URI format: neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-password

# Firebase (auth + existing Firestore)
# Already hard-coded in firebase-config.js for this project
# You only need these if you move config to env vars later:
# FIREBASE_API_KEY=...
# FIREBASE_AUTH_DOMAIN=...
# FIREBASE_PROJECT_ID=...

# Stripe (payments) — https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
