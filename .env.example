# ──────────────────────────────────────────────
# INTELLA — Required Environment Variables
# Copy this file to .env.local for local dev
# Add all keys in your Vercel project settings
# NEVER put real keys in this file — it is committed to git
# ──────────────────────────────────────────────

# Claude AI (brain) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Groq (voice TTS + STT) — https://console.groq.com
GROQ_API_KEY=gsk_...

# Neo4j Aura (database) — https://aura.neo4j.io
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-password

# JWT signing secret — generate a strong random string
JWT_SECRET=change-me-to-a-long-random-string

# Google OAuth Client ID (for Google Sign-In)
# Get from https://console.cloud.google.com → APIs & Services → Credentials
# Also paste into index.html where it says YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
